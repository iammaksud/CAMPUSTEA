# Application
APP_NAME=CampusTea API
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/campustea

# JWT (for upcoming authentication)
SECRET_KEY=change-this-to-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — Vite dev server default
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
